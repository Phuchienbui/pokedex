{
  "name": "pokedex",
  "version": "1.0.0",
  "description": "A browser-based Pokédex built with plain HTML, CSS and JavaScript, using the PokéAPI.",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .git/info/exclude --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .git/info/exclude --ignore-path .prettierignore",
    "check": "npm run lint && npm run format:check && npm run validate:html",
    "validate:html": "html-validate index.html"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "prettier": "^3.9.9"
  }
}
